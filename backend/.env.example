# KaratCore ERP — Production Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO REPOSITORIES

APP_ENV=development
PROJECT_NAME="KaratCore ERP Backend"
API_V1_STR="/api/v1"

# Database Connection (PostgreSQL for production; SQLite default for dev)
DATABASE_URL=postgresql://karatcore_user:secure_password@localhost:5432/karatcore_db

# Security & JWT Token Configuration
JWT_SECRET_KEY=karatcore_super_secret_jwt_key_change_in_production_998214
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://app.karatcore.com"]

# File & Document Storage Configuration
STORAGE_PROVIDER=local
STORAGE_BUCKET=karatcore-kyc-documents
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Integration Providers
PAYMENT_PROVIDER=MOCK
IDENTITY_PROVIDER=MOCK

# Observability & Logging
LOG_LEVEL=INFO
SENTRY_DSN=
