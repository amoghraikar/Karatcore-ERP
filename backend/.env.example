# KaratCore ERP — Production Environment Configuration Template
APP_ENV=development
PROJECT_NAME="KaratCore ERP Backend"
API_V1_STR="/api/v1"

# 1. Supabase PostgreSQL Database Connection
# Supabase Dashboard > Project Settings > Database > Connection String
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 2. Supabase API Credentials
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Security & JWT Token Configuration
JWT_SECRET_KEY=karatcore_super_secret_jwt_key_change_in_production_998214
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://app.karatcore.com"]

# File & Document Storage Configuration
STORAGE_PROVIDER=local
STORAGE_BUCKET=karatcore-kyc-documents
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Integration Providers
PAYMENT_PROVIDER=MOCK
IDENTITY_PROVIDER=MOCK

# SMS Gateway Configuration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+18885550199
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# SMTP Email Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_TLS=True
EMAILS_FROM_EMAIL=notifications@karatcore.com
EMAILS_FROM_NAME="KaratCore Security"

# Observability & Logging
LOG_LEVEL=INFO
SENTRY_DSN=
